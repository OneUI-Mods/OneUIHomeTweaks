<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:orientation="vertical" android:background="?attr/colorSurface" android:layout_width="match_parent" android:layout_height="match_parent">
  <com.google.android.material.appbar.MaterialToolbar android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/app_name" app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
  <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewFilledStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" app:cardCornerRadius="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp" android:paddingStart="20dp" android:paddingEnd="20dp">
      <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/master" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/master" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <androidx.core.widget.NestedScrollView android:id="@+id/page_0" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="visible" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewFilledStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/home_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/scope_home" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_labels" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/home_labels">
              <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/label_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_bar" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/status_bar">
              <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/status_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/drawer_labels" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/drawer_labels">
              <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/drawer_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/page_notifications" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/page_note" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/recents_portrait" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/recents_portrait" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/recents_portrait_note" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/recents_hide_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="@string/recents_hide_bar" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/recents_hide_bar_note" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/save" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/normal_no_restart" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView android:id="@+id/page_1" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewFilledStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/systemui_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/scope_volume" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/volume_theme" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/volume_theme">
              <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/volume_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewFilledStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/preview_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/scope_preview" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/live_preview" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/preview_note" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/save_appearance" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/save" />
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView android:id="@+id/page_2" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.card.MaterialCardView style="?attr/materialCardViewFilledStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="24dp" app:strokeWidth="0dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_title" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <LinearLayout android:id="@+id/status_cards" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_help" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/root_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/root_pending" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.core.widget.NestedScrollView android:id="@+id/page_3" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/restart_home" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/restart_home" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/restart_note" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reload_targets" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/reload_targets" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clear_guard" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/clear_guard" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/clear_guard_note" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.button.MaterialButton android:id="@+id/language" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/language" />
        <com.google.android.material.button.MaterialButton android:id="@+id/licenses" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/licenses" />
        <com.google.android.material.button.MaterialButton android:id="@+id/help" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/help" />
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
  </FrameLayout>
  <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" style="@style/Widget.Material3.BottomNavigationView" android:layout_width="match_parent" android:layout_height="wrap_content" app:menu="@menu/navigation" app:labelVisibilityMode="labeled" />
</LinearLayout>
